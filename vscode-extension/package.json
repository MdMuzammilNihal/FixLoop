{
  "name": "fixloop-vscode",
  "displayName": "FixLoop",
  "description": "AI-powered code analysis, bug fixing, and optimization for VS Code",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers"
  ],
  "activationEvents": [
    "onCommand:fixloop.analyzeCode",
    "onCommand:fixloop.fixCode",
    "onCommand:fixloop.optimizeCode",
    "onCommand:fixloop.executeCode"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fixloop.analyzeCode",
        "title": "FixLoop: Analyze Code"
      },
      {
        "command": "fixloop.fixCode",
        "title": "FixLoop: Fix Code"
      },
      {
        "command": "fixloop.optimizeCode",
        "title": "FixLoop: Optimize Code"
      },
      {
        "command": "fixloop.executeCode",
        "title": "FixLoop: Execute Code"
      }
    ],
    "configuration": {
      "title": "FixLoop",
      "properties": {
        "fixloop.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "The URL of the FixLoop server"
        },
        "fixloop.autoAnalyze": {
          "type": "boolean",
          "default": false,
          "description": "Automatically analyze code on save"
        },
        "fixloop.showInlineErrors": {
          "type": "boolean",
          "default": true,
          "description": "Show errors inline in the editor"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "fixloop.analyzeCode",
          "group": "fixloop"
        },
        {
          "when": "editorHasSelection",
          "command": "fixloop.fixCode",
          "group": "fixloop"
        },
        {
          "when": "editorHasSelection",
          "command": "fixloop.optimizeCode",
          "group": "fixloop"
        },
        {
          "when": "editorHasSelection && editorLangId == 'python'",
          "command": "fixloop.executeCode",
          "group": "fixloop"
        }
      ]
    },
    "languages": [
      {
        "id": "python",
        "extensions": [".py"]
      },
      {
        "id": "javascript",
        "extensions": [".js"]
      },
      {
        "id": "typescript",
        "extensions": [".ts"]
      },
      {
        "id": "java",
        "extensions": [".java"]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.3.1",
    "@typescript-eslint/parser": "^5.3.1",
    "eslint": "^8.2.0",
    "typescript": "^4.5.2"
  },
  "dependencies": {
    "axios": "^0.24.0"
  }
} 